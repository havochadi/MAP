# Copy this file to .env and fill in values before running the app.

# Postgres, hosted on Supabase. Get both connection strings from the
# Supabase dashboard: Project Settings -> Database -> Connect -> Prisma tab.
#
# Both need `sslmode=require`: Supabase's pooler presents a chain rooted at
# its own private "Supabase Root 2021 CA", which isn't in the public trust
# store Prisma/Node validate against by default. Without sslmode=require,
# connections fail with P1001 "Can't reach database server" — a misleading
# error, since the real cause is TLS chain-of-trust, not reachability.
#
# Pooled (PgBouncer, transaction mode) — used by the running app.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true&sslmode=require"

# Direct/session-mode — used by Prisma Migrate (the pooler's transaction mode
# doesn't support the DDL/prepared statements migrations rely on).
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?sslmode=require"

# Signs/encrypts NextAuth session JWTs. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
