// Prisma schema for the MENDAKI Achievement Programme (MAP) coach app.
// See /Users/adilhadizul/.claude/plans/sharded-singing-lamport.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Subject {
  ENGLISH
  MATH
  SCIENCE
}

enum Level {
  P1
  P2
  P3
  P4
  P5
  P6
  SEC1
  SEC2
  SEC3
  SEC4
  SEC5
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum StudentStatus {
  ACTIVE
  REMOVED
  GRADUATED
}

enum ProgressStatus {
  PLANNED
  COMPLETED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  classes  Class[]
  students Student[]

  @@index([name])
}

model Class {
  // Display label (e.g. "P5 Science — Tue 4:00pm") is derived in src/lib/format.ts
  // from subject+level+dayOfWeek+startTime — there is deliberately no stored "name"
  // field, so there is exactly one source of truth for it.
  id              String    @id @default(cuid())
  venueId         String
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  subject         Subject
  level           Level
  dayOfWeek       DayOfWeek
  startTime       String // "HH:mm", 24h
  durationMinutes Int       @default(90)
  createdAt       DateTime  @default(now())

  enrollments        Enrollment[]
  assignments        ClassAssignment[]
  attendanceSessions AttendanceSession[]
  progress           ClassProgress[]

  @@index([venueId])
  @@index([subject, level])
}

model Coach {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  isAdmin             Boolean   @default(false)
  phone               String?
  trainingCompletedAt DateTime?
  // Cheap, no-extra-infra brute-force mitigation for login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  assignments    ClassAssignment[]
  markedSessions AttendanceSession[]

  @@index([email])
}

model Student {
  id            String        @id @default(cuid())
  name          String
  level         Level
  venueId       String
  venue         Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  guardianName  String?
  guardianPhone String?
  status        StudentStatus @default(ACTIVE)
  registeredAt  DateTime      @default(now())
  // A short, coach-assigned access code for the student's own read-only
  // portal (their attendance + progress only — no write actions exist
  // there). Deliberately plain text, not hashed: it functions as a shared
  // "class code" rather than a password (MAP students span P1-Sec4, so as
  // young as ~7), it protects only the student's own already-low-sensitivity
  // view of data their coach already manages, and — unlike a bcrypt hash —
  // it can still be looked up directly by value.
  //
  // No failedLoginAttempts/lockedUntil here (unlike Coach): that pattern
  // needs a wrong guess to still identify *which account* to lock, which
  // works for email+password (email finds the account, password is checked
  // second) but not here — a wrong code matches no record at all, so
  // there's nothing to increment. The code's own entropy (6 chars from a
  // 32-symbol alphabet, ~1 billion combinations) is the defense instead,
  // appropriate for a view-only, low-sensitivity account.
  loginCode     String        @unique

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@index([venueId])
  @@index([level])
}

model Enrollment {
  // A student may hold at most 3 ACTIVE enrollments (real MAP rule: up to 3
  // subjects). Enforced in src/actions/students.ts, not the DB — SQLite has no
  // clean declarative way to express "count of related rows <= 3".
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([studentId, classId])
  @@index([classId])
  @@index([studentId])
}

model ClassAssignment {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([coachId, classId])
  @@index([classId])
}

model AttendanceSession {
  // sessionDate is a "YYYY-MM-DD" string (Singapore calendar date), not a
  // DateTime — this sidesteps timezone bugs entirely since we only ever need
  // "which calendar day," never a time-of-day. See src/lib/dates.ts.
  id              String    @id @default(cuid())
  classId         String
  class           Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionDate     String
  markedByCoachId String?
  markedByCoach   Coach?    @relation(fields: [markedByCoachId], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  records AttendanceRecord[]

  // One session per class per calendar day; every write upserts on this key,
  // which is what makes double-tapping/double-submitting attendance safe.
  @@unique([classId, sessionDate])
  @@index([sessionDate])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus
  // A "valid reason" absence, per real MAP policy on the 6-consecutive-lesson
  // removal rule. Excluded from both the consecutive-absence streak and the
  // attendance-% denominator (see src/lib/attendance-stats.ts).
  excused             Boolean           @default(false)
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Re-tapping the same student's status upserts on this key — never duplicates.
  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
}

model CurriculumTopic {
  id                 String   @id @default(cuid())
  subject            Subject
  level              Level
  order              Int
  title              String
  strand             String? // e.g. "Number & Algebra", "Cycles", "Oracy"
  description        String? // short 1-3 sentence overview, shown wherever space is tight
  // A thorough explanation of the underlying concept itself — what a coach
  // needs to actually understand before teaching it. Distinct from
  // `description` (a scope statement) and `teachingSteps` (lesson-delivery
  // instructions) — this is the content/theory explained in its own right.
  conceptExplanation String?
  // JSON-encoded array of { problem: string; solution: string[] } — fully
  // worked example problems with their step-by-step solutions spelled out.
  workedExamples     String?
  // JSON-encoded string[] — a detailed, ordered, step-by-step lesson sequence
  // for this topic (hook, teach, practice, common errors, etc.). Stored as
  // JSON text rather than Prisma's Json scalar so serialization is fully
  // explicit and consistent with how the rest of this schema is written.
  teachingSteps      String?
  // JSON-encoded DiagramSpec (src/lib/diagrams.ts) — structured data for a
  // simple illustrative diagram, rendered by a fixed set of tested SVG
  // components (src/components/curriculum/diagrams/), not hand-authored SVG.
  // Optional — most topics don't need one.
  diagramSpec        String?
  createdAt          DateTime @default(now())

  progress ClassProgress[]

  @@unique([subject, level, order])
  @@index([subject, level])
}

model ClassProgress {
  id                String          @id @default(cuid())
  classId           String
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  curriculumTopicId String
  topic             CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  status            ProgressStatus  @default(PLANNED)
  plannedDate       String // "YYYY-MM-DD" — drives "what's due today"
  completedDate     String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([classId, curriculumTopicId])
  @@index([classId])
}
