// Prisma schema for the MENDAKI Achievement Programme (MAP) coach app.
// See /Users/adilhadizul/.claude/plans/sharded-singing-lamport.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase-recommended split: DATABASE_URL is the pooled (PgBouncer) connection
  // the running app uses; DIRECT_URL is the unpooled connection Prisma Migrate
  // needs (PgBouncer's transaction mode doesn't support the DDL/prepared
  // statements migrations rely on).
  directUrl = env("DIRECT_URL")
}

enum Subject {
  ENGLISH
  MATH
  SCIENCE
}

enum Level {
  P1
  P2
  P3
  P4
  P5
  P6
  SEC1
  SEC2
  SEC3
  SEC4
  SEC5
  JC1
  JC2
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum EmergencyContactRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER // the source registration form only lists the first three; added as a catch-all so no real visitor is unrepresentable
}

enum ReferralSource {
  MAP_CLASS
  SOCIAL_MEDIA
  FRIENDS_FAMILY
  OTHER
}

enum CoachShiftStatus {
  OPEN     // clocked in, not yet clocked out
  PENDING  // clocked out (or edited), awaiting admin review
  APPROVED // admin-approved, counts toward pay
  REJECTED // admin-rejected, does not count toward pay
}

// Coaching runs in fixed scheduled sessions, never freeform hours — see
// src/lib/shift-blocks.ts for each block's day(s), time window, and paid
// hours. Pay is flat per block (src/lib/pay.ts), not prorated from actual
// clock-in/out — those timestamps are kept purely as an attendance record.
enum ShiftBlock {
  WEEKDAY_EVENING   // Tue & Thu, 5:00–9:00 PM (4h)
  WEEKEND_MORNING   // Sat & Sun, 10:00 AM–2:00 PM (4h)
  WEEKEND_AFTERNOON // Sat & Sun, 2:00–5:00 PM (3h)
}

enum StudentStatus {
  ACTIVE
  REMOVED
  GRADUATED
}

enum ProgressStatus {
  PLANNED
  COMPLETED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  classes      Class[]
  checkIns     CheckIn[]
  coachShifts  CoachShift[]

  @@index([name])
}

model Class {
  // Display label (e.g. "P5 Science — Tue 4:00pm") is derived in src/lib/format.ts
  // from subject+level+dayOfWeek+startTime — there is deliberately no stored "name"
  // field, so there is exactly one source of truth for it.
  id              String    @id @default(cuid())
  venueId         String
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  subject         Subject
  level           Level
  dayOfWeek       DayOfWeek
  startTime       String // "HH:mm", 24h
  durationMinutes Int       @default(90)
  createdAt       DateTime  @default(now())

  enrollments           Enrollment[]
  assignments           ClassAssignment[]
  attendanceSessions    AttendanceSession[]
  progress              ClassProgress[]
  guardianNotifications GuardianNotification[]

  @@index([venueId])
  @@index([subject, level])
}

model Coach {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  isAdmin             Boolean   @default(false)
  phone               String?
  trainingCompletedAt DateTime?
  // Cheap, no-extra-infra brute-force mitigation for login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  assignments    ClassAssignment[]
  markedSessions AttendanceSession[]
  shifts         CoachShift[] @relation("CoachShifts")
  approvedShifts CoachShift[] @relation("ApprovedShifts")

  @@index([email])
}

model Student {
  id       String @id @default(cuid())
  name     String
  level    Level

  contactNumber String
  schoolName    String
  email         String
  isMapStudent  Boolean @default(true)

  // Renamed from guardianName/guardianPhone to match what the registration
  // form actually calls this field (Student Emergency Contact Name /
  // relationship / number) — same person, more accurate names.
  emergencyContactName         String
  emergencyContactRelationship EmergencyContactRelationship
  emergencyContactPhone        String

  // "How do you know about Study Space?" — analytics only, nothing reads it.
  // Simplification vs. the source form: no free-text elaboration when
  // "Other" is picked, just the category.
  referralSource ReferralSource?

  status       StudentStatus @default(ACTIVE) // now a purely manual admin toggle — nothing auto-sets REMOVED anymore
  registeredAt DateTime      @default(now())

  // Entire credential for both the student portal login AND the QR payload
  // (the QR literally encodes this string). Deliberately plain text, not
  // hashed: it functions as a shared "class code" rather than a password
  // (MAP students span P1-JC2, so as young as ~7), it protects only the
  // student's own already-low-sensitivity view of data their coach already
  // manages, and it needs to be looked up directly by value.
  loginCode String @unique

  enrollments           Enrollment[]           // unused going forward — see Global Constraints
  attendanceRecords     AttendanceRecord[]      // unused going forward — see Global Constraints
  guardianNotifications GuardianNotification[]  // old class-attendance flow, untouched — see Step 5
  checkInNotifications  CheckInNotification[]
  checkIns              CheckIn[]

  @@index([level])
}

model Enrollment {
  // A student may hold at most 3 ACTIVE enrollments (real MAP rule: up to 3
  // subjects). Enforced in src/actions/students.ts, not the DB — SQLite has no
  // clean declarative way to express "count of related rows <= 3".
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([studentId, classId])
  @@index([classId])
  @@index([studentId])
}

model ClassAssignment {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([coachId, classId])
  @@index([classId])
}

model AttendanceSession {
  // sessionDate is a "YYYY-MM-DD" string (Singapore calendar date), not a
  // DateTime — this sidesteps timezone bugs entirely since we only ever need
  // "which calendar day," never a time-of-day. See src/lib/dates.ts.
  id              String    @id @default(cuid())
  classId         String
  class           Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionDate     String
  markedByCoachId String?
  markedByCoach   Coach?    @relation(fields: [markedByCoachId], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  records AttendanceRecord[]

  // One session per class per calendar day; every write upserts on this key,
  // which is what makes double-tapping/double-submitting attendance safe.
  @@unique([classId, sessionDate])
  @@index([sessionDate])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus
  // A "valid reason" absence, per real MAP policy on the 6-consecutive-lesson
  // removal rule. Excluded from both the consecutive-absence streak and the
  // attendance-% denominator (see src/lib/attendance-stats.ts).
  excused             Boolean           @default(false)
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Re-tapping the same student's status upserts on this key — never duplicates.
  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
}

model GuardianNotification {
  // A logged record of the guardian-contact API firing when a student is
  // marked PRESENT/LATE on a submitted attendance session. There is no real
  // SMS/email provider wired up (deliberate, see the route handler) — this
  // table is itself the "delivery," simulated and auditable rather than
  // actually sent.
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionDate    String
  status         AttendanceStatus
  // Snapshot of Student.guardianPhone at send time, not a live reference —
  // preserves what the notification actually went to even if the phone on
  // file changes later. Null when the student had no guardian phone on file.
  recipientPhone String?
  delivered      Boolean
  message        String
  sentAt         DateTime         @default(now())

  // One notification per student per class per day — resubmitting a
  // corrected session (after reopening) doesn't re-spam the same guardian.
  @@unique([studentId, classId, sessionDate])
  @@index([studentId])
}

model CheckIn {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Snapshot of the scanning coach's shift venue at check-in time — stored
  // here (not just derived via coachShift.venueId) so a later edit to a
  // shift's venue can never retroactively rewrite where a visit happened.
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // "YYYY-MM-DD" — same convention as every other date-only field in this
  // schema, sidesteps timezone bugs.
  checkInDate String
  checkedInAt DateTime @default(now())

  // Which coach and which of their shifts performed the scan — reached via
  // this relation rather than a separate coachId field, since no scan
  // happens without an open shift.
  coachShiftId String
  coachShift   CoachShift @relation(fields: [coachShiftId], references: [id], onDelete: Restrict)

  notification CheckInNotification?

  // Re-scanning the same person at the same venue the same day is a
  // harmless no-op, not a duplicate or an error.
  @@unique([studentId, venueId, checkInDate])
  @@index([venueId, checkInDate])
  @@index([coachShiftId])
}

model CheckInNotification {
  // The check-in flow's equivalent of GuardianNotification, above — a
  // separate model rather than a repoint of that one, since
  // GuardianNotification's classId/sessionDate/status fields are still
  // load-bearing for the untouched class-attendance flow. Same simulated
  // "delivery record" reasoning as that model: no real SMS/email provider
  // exists, this row IS the delivery.
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkInId      String   @unique
  checkIn        CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  // Snapshot of Student.emergencyContactPhone at send time.
  recipientPhone String?
  delivered      Boolean
  message        String
  sentAt         DateTime @default(now())
}

model CoachShift {
  id      String @id @default(cuid())
  coachId String
  coach   Coach  @relation("CoachShifts", fields: [coachId], references: [id], onDelete: Restrict)
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  // "YYYY-MM-DD", set once at clock-in and never independently edited —
  // editing only ever corrects clockInAt/clockOutAt within that same day.
  shiftDate String
  // Chosen at clock-in, never independently edited — same rationale as
  // shiftDate (a wrong pick has no in-place fix; reject and re-log it).
  // Determines paid hours; clockInAt/clockOutAt below no longer do.
  shiftBlock ShiftBlock

  clockInAt  DateTime
  clockOutAt DateTime? // null while OPEN — real arrival/departure, kept for
  // attendance only; see shiftBlock for what actually drives pay.

  status CoachShiftStatus @default(OPEN)

  approvedByCoachId String?
  approvedByCoach   Coach?    @relation("ApprovedShifts", fields: [approvedByCoachId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  // Required by the action layer on reject; optional note on approve.
  reviewNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns CheckIn[]

  @@index([coachId])
  @@index([venueId, shiftDate])
  @@index([status])
}

model CurriculumTopic {
  id                 String   @id @default(cuid())
  subject            Subject
  level              Level
  order              Int
  title              String
  strand             String? // e.g. "Number & Algebra", "Cycles", "Oracy"
  description        String? // short 1-3 sentence overview, shown wherever space is tight
  // A thorough explanation of the underlying concept itself — what a coach
  // needs to actually understand before teaching it. Distinct from
  // `description` (a scope statement) and `teachingSteps` (lesson-delivery
  // instructions) — this is the content/theory explained in its own right.
  conceptExplanation String?
  // JSON-encoded array of { problem: string; solution: string[] } — fully
  // worked example problems with their step-by-step solutions spelled out.
  workedExamples     String?
  // JSON-encoded string[] — a detailed, ordered, step-by-step lesson sequence
  // for this topic (hook, teach, practice, common errors, etc.). Stored as
  // JSON text rather than Prisma's Json scalar so serialization is fully
  // explicit and consistent with how the rest of this schema is written.
  teachingSteps      String?
  // JSON-encoded DiagramSpec (src/lib/diagrams.ts) — structured data for a
  // simple illustrative diagram, rendered by a fixed set of tested SVG
  // components (src/components/curriculum/diagrams/), not hand-authored SVG.
  // Optional — most topics don't need one.
  diagramSpec        String?
  createdAt          DateTime @default(now())

  progress ClassProgress[]

  @@unique([subject, level, order])
  @@index([subject, level])
}

model ClassProgress {
  id                String          @id @default(cuid())
  classId           String
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  curriculumTopicId String
  topic             CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  status            ProgressStatus  @default(PLANNED)
  plannedDate       String // "YYYY-MM-DD" — drives "what's due today"
  completedDate     String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([classId, curriculumTopicId])
  @@index([classId])
}
